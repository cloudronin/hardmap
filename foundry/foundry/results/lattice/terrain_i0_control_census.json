 "purpose": "settle computability and variance of every control tier before the seal's text fixes, and evaluate the kill condition on tier-2 coverage",
 "tier_definitions": {
  "tier0": "uniform random subset of the ambient space at matched r",
  "tier1": "matched-marginal \u2014 size r, per-coordinate inclusion frequencies matched",
  "tier2": "matched-object \u2014 r random members of the region's own containing species"
 },
 "tier2_is_structurally_unavailable_for": {
  "feasible": "the region IS the species; a species-drawn control at matched r is the region",
  "solutions": "the only natural containing family is the ambient space, i.e. tier 0"
 },
